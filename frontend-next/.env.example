# Copy to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser.

# Base URL of backend-go (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# true = use in-memory mock data (Homework 1, no backend needed)
# false = call the real Go API (Homework 2)
NEXT_PUBLIC_USE_MOCK=false
